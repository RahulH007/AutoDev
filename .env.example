# ── LLM provider ─────────────────────────────────────────────────
# Which provider to use: google | groq | openai | ollama | cerebras
LLM_PROVIDER=google

# Credentials. Only the key for your chosen provider (and any
# fallback providers) is required.
GOOGLE_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=
# OPENAI_API_KEY=
# CEREBRAS_API_KEY=

# Groq meters tokens per organisation, so several accounts are several
# independent per-minute windows rather than one shared between them. Numbering
# the keys turns them into a pool: each account gets its own token budget, learns
# its own rate limit from its own rejections, and appears separately in the cost
# report. Calls go to whichever account has room.
#
# Set as many or as few as you have; gaps are fine. Numbered keys REPLACE the
# plain GROQ_API_KEY above rather than joining it, so a pool is exactly what you
# numbered. Leave these unset and nothing changes.
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# GROQ_API_KEY_4=

# OLLAMA_BASE_URL=http://localhost:11434

# Per-purpose model overrides. Leave unset to use the provider default.
# heavy      = developer agent      structured = pm / architecture / qa
# text       = the PDF prose        cheap      = qa file triage
# MODEL_HEAVY=gemini-2.5-pro
# MODEL_STRUCTURED=gemini-2.5-flash
# MODEL_TEXT=gemini-2.5-flash
# MODEL_CHEAP=gemini-2.5-flash-lite

# Comma-separated providers to fall back to when the primary fails.
# LLM_FALLBACK_PROVIDERS=groq

# ── Difficulty-based model routing ───────────────────────────────
# A developer service gets the same model whether it is a three-file worker or a
# thirty-endpoint API. Turn this on and the architecture's own description of a
# service -- its files, endpoints, data models and dependencies -- picks a model
# tier, so a small service is written by a small model.
#
# Deterministic and explainable: the score and the tier appear in the run log and
# in the cost report. It routes the developer stage only; every other call keeps
# the model it has today. Off by default, and off changes nothing.
ROUTING_ENABLED=false
# Where the tier boundaries fall on the difficulty score, which is
# 2×files + endpoints + data models + 2×dependencies. The middle band is the
# widest on purpose: an ordinary service should be ordinary.
# ROUTING_LOW_MAX_SCORE=12
# ROUTING_HIGH_MIN_SCORE=40
# Which model serves each tier. Separate from the keys above: an account says who
# pays, a tier says what to run. Unset uses the provider's per-purpose default.
# GROQ_MODEL_LOW=openai/gpt-oss-20b
# GROQ_MODEL_MEDIUM=openai/gpt-oss-120b
# GROQ_MODEL_HIGH=openai/gpt-oss-120b
# When verification shows a service does not compile, does not match the approved
# architecture, fails its tests, or has a serious reviewed bug, the next attempt
# at that service uses the next model tier up. One step at a time, and this many
# times per service in total. Resource problems -- rate limits, exhausted
# accounts, rejected keys -- never escalate: they say nothing about the code.
# MAX_MODEL_ESCALATIONS=1

# ── Generation behaviour ─────────────────────────────────────────
LLM_TEMPERATURE=0.2
# Only transient failures (429, 5xx, timeouts) are retried at all. A 400 the
# model cannot satisfy falls straight to the next strategy instead.
LLM_MAX_RETRIES=3
# Wait before the first retry, doubling after that, capped at 60s. Ignored
# when the provider names its own wait in a Retry-After header or message.
LLM_RETRY_BACKOFF_SECONDS=2.0
# Cap on any single retry wait, including one the provider asked for.
LLM_RETRY_MAX_DELAY_SECONDS=60.0
LLM_TIMEOUT_SECONDS=300
# Ceiling on a single completion. Providers cap this well below what a large
# schema needs -- Groq gives qwen/qwen3.8-27b 2048, which truncates a PRD
# mid-JSON. Keep it under LLM_TOKENS_PER_MINUTE. 0 = the provider's default.
# This is the fallback for any purpose that names no ceiling of its own.
LLM_MAX_OUTPUT_TOKENS=4096
# Per-purpose ceilings, sized to what each kind of call actually returns. The
# figure is both what the client asks for and what the budget reserves, so a
# purpose set larger than it needs holds that much of the window for nothing:
# QA triage answers with a list of file paths, not 4,096 tokens of one. Unset
# falls back to LLM_MAX_OUTPUT_TOKENS; 0 = the provider's default.
# MAX_OUTPUT_HEAVY=4096
# MAX_OUTPUT_STRUCTURED=3500
# MAX_OUTPUT_TEXT=2000
# MAX_OUTPUT_CHEAP=1000
# Narrow a purpose's ceiling when the caller can say, deterministically and
# before the call, how large the answer needs to be -- the developer stage sizes
# each service from the files and endpoints its architecture contract requires.
# The configured ceiling above is always the hard maximum; this can only narrow.
# Off by default: a ceiling set too low truncates a structured response mid-JSON,
# which fails every rung of the ladder and costs more than the window it saved.
ADAPTIVE_CEILINGS=false
# The floor no adapted ceiling may go below, itself clamped to the configured
# ceiling. Above MAX_OUTPUT_CHEAP so adapting can never produce a completion
# budget smaller than one this project already runs on.
# ADAPTIVE_MIN_OUTPUT_TOKENS=1024
# Adapted ceilings round up to a multiple of this: a little slack, and few enough
# distinct values that the model cache still reuses clients.
# ADAPTIVE_CEILING_BLOCK=256
# What one generated service is expected to cost: a fixed allowance for the
# project-level fields, plus one per required file, plus one per endpoint and
# data model. Over-estimating is free, since the result is clamped.
# ADAPTIVE_SERVICE_BASE_TOKENS=800
# ADAPTIVE_SERVICE_FILE_TOKENS=400
# ADAPTIVE_SERVICE_DECLARATION_TOKENS=150
# Whether a *run* generates client-facing PDFs as it goes. Off by default: the
# structured JSON is the canonical artifact and the console renders the PRD and
# the architecture directly from it, so producing them again as prose costs four
# extra model calls per run against the same per-minute window and shows the
# reader nothing new.
#
# Off does not mean unavailable. "Export PDF" in the console renders the same
# document on request whatever this is set to -- that is a person asking for a
# file, not a pipeline spending on one nobody wanted. Setting this to true only
# restores the old behaviour of producing them up front, unasked.
GENERATE_PDFS=false
MAX_DEVELOPER_RETRIES=3
# Lowest QA code-quality score (1-10) that still passes.
MIN_QUALITY_SCORE=7
# Per-stage wall clock budget in seconds.
STAGE_TIMEOUT_SECONDS=600

# ── Rate limiting ────────────────────────────────────────────────
# Providers meter tokens over a rolling minute and reject anything that crosses
# the line. The pipeline paces itself under this ceiling rather than discovering
# it as a failed run: a call that will not fit waits for room instead.
# 12000 is Groq's free tier. Raise it for a paid tier or a roomier provider --
# setting it too high just means the provider does the rejecting again.
# A starting guess, not the last word: the first rejection states the ceiling
# the provider actually enforces and the budget adopts it. Note the learning
# only happens on rejection, so a value set too low is never corrected upward.
LLM_TOKENS_PER_MINUTE=12000
# Reserved for a response whose length cannot be known before the call.
LLM_OUTPUT_RESERVE=2000

# ── Code verification ────────────────────────────────────────────
# local = subprocess on this host, docker = container isolation
RUNNER_BACKEND=local
VERIFY_INSTALL_DEPS=true
VERIFY_TIMEOUT_SECONDS=300
VERIFY_OUTPUT_CAP_BYTES=200000

# ── Storage ──────────────────────────────────────────────────────
RUNS_DIR=runs
DATABASE_PATH=data/agentforge.db
CHECKPOINT_PATH=data/checkpoints.db

# ── Service ──────────────────────────────────────────────────────
# Extra origins allowed beyond loopback. A browser treats localhost and
# 127.0.0.1 as distinct origins, so both are named here.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Allow the console on any loopback port. Next.js moves it to 3001 when another
# dev server holds 3000, and a list naming a port rejects the preflight — which
# the console can only report as "the API is not reachable". Set false to pin a
# deployment to CORS_ORIGINS alone.
CORS_ALLOW_LOOPBACK=true

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
# true emits one JSON object per line instead of human-readable text.
LOG_JSON=false

# ── Optional tracing ─────────────────────────────────────────────
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=agentforge
